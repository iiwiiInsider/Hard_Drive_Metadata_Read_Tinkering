        MessageBoxW(hWnd, L"Unsafe mode requires Administrator elevation.", L"Admin required", MB_OK | MB_ICONWARNING);
        g_unsafeModeEnabled = false;
        SaveSettings();
        SyncCheckboxToUnsafe(hWnd);
        return;
    }

    if (g_unsafeModeEnabled)
    {
        g_unsafeModeEnabled = false;
        SaveSettings();
        SyncCheckboxToUnsafe(hWnd);
        AppendOutput(L"Unsafe mode disabled.");
        return;
    }

    int first = MessageBoxW(hWnd, L"WARNING: Unsafe mode enables risky operations. Continue?", L"Unsafe mode", MB_OKCANCEL | MB_ICONEXCLAMATION);
    if (first != IDOK)
    {
        g_unsafeModeEnabled = false;
        SyncCheckboxToUnsafe(hWnd);
        return;
    }

    int second = MessageBoxW(hWnd, L"Step 2/2: Enable Unsafe Mode now?", L"Unsafe mode", MB_YESNO | MB_ICONWARNING);
    g_unsafeModeEnabled = (second == IDYES);
    SaveSettings();
    SyncCheckboxToUnsafe(hWnd);
    AppendOutput(g_unsafeModeEnabled ? L"Unsafe mode enabled." : L"Unsafe mode remains disabled.");
}

static std::wstring DriveTypeToText(UINT type)
{
    switch (type)
    {
    case DRIVE_FIXED: return L"Fixed";
    case DRIVE_REMOVABLE: return L"Removable";
    case DRIVE_REMOTE: return L"Network";
    case DRIVE_CDROM: return L"CD-ROM";
    case DRIVE_RAMDISK: return L"RAM Disk";
    case DRIVE_NO_ROOT_DIR: return L"No Root";
    default: return L"Unknown";
    }
}

static std::wstring QueryBitLockerStatus(const std::wstring& root)
{
    HRESULT hr = CoInitializeEx(nullptr, COINIT_MULTITHREADED);
    bool shouldUninit = SUCCEEDED(hr);

    hr = CoInitializeSecurity(nullptr, -1, nullptr, nullptr, RPC_C_AUTHN_LEVEL_DEFAULT, RPC_C_IMP_LEVEL_IMPERSONATE, nullptr, EOAC_NONE, nullptr);
    if (FAILED(hr) && hr != RPC_E_TOO_LATE)
    {
        if (shouldUninit) CoUninitialize();
        return L"Unknown";
    }

    IWbemLocator* locator = nullptr;
    hr = CoCreateInstance(CLSID_WbemLocator, nullptr, CLSCTX_INPROC_SERVER, IID_IWbemLocator, reinterpret_cast<LPVOID*>(&locator));
    if (FAILED(hr) || !locator)
    {
        if (shouldUninit) CoUninitialize();
        return L"Unknown";
    }

    IWbemServices* services = nullptr;
    hr = locator->ConnectServer(_bstr_t(L"ROOT\\CIMV2\\Security\\MicrosoftVolumeEncryption"), nullptr, nullptr, nullptr, 0, nullptr, nullptr, &services);
    if (FAILED(hr) || !services)
    {
        locator->Release();
        if (shouldUninit) CoUninitialize();
        return L"Unknown";
    }

    hr = CoSetProxyBlanket(services, RPC_C_AUTHN_WINNT, RPC_C_AUTHZ_NONE, nullptr, RPC_C_AUTHN_LEVEL_CALL, RPC_C_IMP_LEVEL_IMPERSONATE, nullptr, EOAC_NONE);
    if (FAILED(hr))
    {
        services->Release();
        locator->Release();
        if (shouldUninit) CoUninitialize();
        return L"Unknown";
    }

    std::wstring letter = root.substr(0, 2);
    std::wstring query = L"SELECT ProtectionStatus FROM Win32_EncryptableVolume WHERE DriveLetter='" + letter + L"'";

    IEnumWbemClassObject* en = nullptr;
    hr = services->ExecQuery(bstr_t("WQL"), bstr_t(query.c_str()), WBEM_FLAG_FORWARD_ONLY | WBEM_FLAG_RETURN_IMMEDIATELY, nullptr, &en);

    std::wstring status = L"Unknown";
    if (SUCCEEDED(hr) && en)
    {
        IWbemClassObject* obj = nullptr;
        ULONG ret = 0;
        hr = en->Next(WBEM_INFINITE, 1, &obj, &ret);
        if (SUCCEEDED(hr) && ret == 1 && obj)
        {
            VARIANT v;
            VariantInit(&v);
            if (SUCCEEDED(obj->Get(L"ProtectionStatus", 0, &v, nullptr, nullptr)) && v.vt == VT_I4)
            {
                if (v.intVal == 0) status = L"Off";
                else if (v.intVal == 1) status = L"On";
            }
            VariantClear(&v);
            obj->Release();
        }
        en->Release();
    }

    services->Release();
    locator->Release();
    if (shouldUninit) CoUninitialize();

    return status;
}

static void RefreshDriveList()
{
    g_drives.clear();

    wchar_t drives[512] = {};
    DWORD len = GetLogicalDriveStringsW(static_cast<DWORD>(std::size(drives)), drives);
    if (len == 0 || len >= std::size(drives))
    {
        AppendOutput(L"Drive enumeration failed.");
        return;
    }

    const wchar_t* cur = drives;
    while (*cur)
    {
        DriveInfo di;
        di.root = cur;
        di.driveType = DriveTypeToText(GetDriveTypeW(cur));

        wchar_t vol[MAX_PATH] = {};
        wchar_t fs[MAX_PATH] = {};
        DWORD serial = 0, maxComp = 0, flags = 0;
        if (GetVolumeInformationW(cur, vol, MAX_PATH, &serial, &maxComp, &flags, fs, MAX_PATH))
        {
            di.volumeName = vol;
            di.fileSystem = fs;
        }
        else
        {
            di.volumeName = L"(unknown)";
            di.fileSystem = L"(unknown)";
        }

        ULARGE_INTEGER freeBytes{}, totalBytes{}, totalFree{};
        if (GetDiskFreeSpaceExW(cur, &freeBytes, &totalBytes, &totalFree))
        {
            di.freeBytes = freeBytes.QuadPart;
            di.totalBytes = totalBytes.QuadPart;
        }

        di.bitLocker = (di.driveType == L"Fixed") ? QueryBitLockerStatus(di.root) : L"N/A";

        g_drives.push_back(di);
        cur += wcslen(cur) + 1;
    }

    SendMessageW(g_hDriveList, LB_RESETCONTENT, 0, 0);
    for (const auto& d : g_drives)
    {
        double totalGb = d.totalBytes > 0 ? (double)d.totalBytes / (1024.0 * 1024.0 * 1024.0) : 0.0;
        double freeGb = d.freeBytes > 0 ? (double)d.freeBytes / (1024.0 * 1024.0 * 1024.0) : 0.0;

        std::wostringstream line;
        line << d.root << L" | " << d.driveType << L" | Vol=" << d.volumeName << L" | FS=" << d.fileSystem
             << L" | Free=" << std::fixed << std::setprecision(1) << freeGb << L"GB/" << totalGb << L"GB"
             << L" | BitLocker=" << d.bitLocker;

        std::wstring s = line.str();
        SendMessageW(g_hDriveList, LB_ADDSTRING, 0, reinterpret_cast<LPARAM>(s.c_str()));
    }

    AppendOutput(L"Drive scan complete.");
}

static bool ReadFileBytes(const std::wstring& path, std::vector<BYTE>& out)
{
    std::ifstream file(path, std::ios::binary);
    if (!file) return false;

    file.seekg(0, std::ios::end);
    std::streamoff len = file.tellg();
    if (len < 0) return false;

    file.seekg(0, std::ios::beg);
    out.resize(static_cast<size_t>(len));
    if (!out.empty())
    {
        file.read(reinterpret_cast<char*>(out.data()), static_cast<std::streamsize>(out.size()));
    }

    return file.good() || file.eof();
}

static bool WriteFileBytes(const std::wstring& path, const std::vector<BYTE>& data)
{
    std::ofstream file(path, std::ios::binary | std::ios::trunc);
    if (!file) return false;

    if (!data.empty())
    {
        file.write(reinterpret_cast<const char*>(data.data()), static_cast<std::streamsize>(data.size()));
    }

    return file.good();
}

static bool DeriveAes256Key(const std::wstring& password, const std::array<BYTE, 16>& salt, std::array<BYTE, 32>& key)
{
    BCRYPT_ALG_HANDLE hSha = nullptr;
    NTSTATUS status = BCryptOpenAlgorithmProvider(&hSha, BCRYPT_SHA256_ALGORITHM, nullptr, 0);
    if (status < 0)
    {
        return false;
    }

    std::vector<BYTE> passBytes(reinterpret_cast<const BYTE*>(password.data()), reinterpret_cast<const BYTE*>(password.data()) + password.size() * sizeof(wchar_t));

    status = BCryptDeriveKeyPBKDF2(hSha,
                                   passBytes.data(), static_cast<ULONG>(passBytes.size()),
                                   const_cast<PUCHAR>(salt.data()), static_cast<ULONG>(salt.size()),
                                   120000,
                                   key.data(), static_cast<ULONG>(key.size()),
                                   0);

    BCryptCloseAlgorithmProvider(hSha, 0);
    return status >= 0;
}

static bool AesCbcEncrypt(const std::vector<BYTE>& plain, const std::array<BYTE, 32>& key, const std::array<BYTE, 16>& iv, std::vector<BYTE>& cipher)
{
    BCRYPT_ALG_HANDLE hAes = nullptr;
    BCRYPT_KEY_HANDLE hKey = nullptr;
    NTSTATUS status = BCryptOpenAlgorithmProvider(&hAes, BCRYPT_AES_ALGORITHM, nullptr, 0);
    if (status < 0) return false;

    status = BCryptSetProperty(hAes, BCRYPT_CHAINING_MODE, reinterpret_cast<PUCHAR>(const_cast<wchar_t*>(BCRYPT_CHAIN_MODE_CBC)), sizeof(BCRYPT_CHAIN_MODE_CBC), 0);
    if (status < 0)
    {
        BCryptCloseAlgorithmProvider(hAes, 0);
        return false;
    }

    DWORD objectLen = 0, resultLen = 0;
    status = BCryptGetProperty(hAes, BCRYPT_OBJECT_LENGTH, reinterpret_cast<PUCHAR>(&objectLen), sizeof(objectLen), &resultLen, 0);
    if (status < 0)
    {
        BCryptCloseAlgorithmProvider(hAes, 0);
        return false;
    }

    std::vector<BYTE> keyObj(objectLen);
    status = BCryptGenerateSymmetricKey(hAes, &hKey, keyObj.data(), objectLen, const_cast<PUCHAR>(key.data()), static_cast<ULONG>(key.size()), 0);
    if (status < 0)
    {
        BCryptCloseAlgorithmProvider(hAes, 0);
        return false;
    }

    std::array<BYTE, 16> ivCopy = iv;
    DWORD outLen = 0;
    status = BCryptEncrypt(hKey,
                           const_cast<PUCHAR>(plain.data()), static_cast<ULONG>(plain.size()),
                           nullptr,
                           ivCopy.data(), static_cast<ULONG>(ivCopy.size()),
                           nullptr, 0, &outLen,
                           BCRYPT_BLOCK_PADDING);

    if (status >= 0)
    {
        cipher.resize(outLen);
        ivCopy = iv;
        status = BCryptEncrypt(hKey,
                               const_cast<PUCHAR>(plain.data()), static_cast<ULONG>(plain.size()),
                               nullptr,
                               ivCopy.data(), static_cast<ULONG>(ivCopy.size()),
                               cipher.data(), outLen, &outLen,
                               BCRYPT_BLOCK_PADDING);
        if (status >= 0)
        {
            cipher.resize(outLen);
        }
    }

    BCryptDestroyKey(hKey);
    BCryptCloseAlgorithmProvider(hAes, 0);
    return status >= 0;
}

static bool AesCbcDecrypt(const std::vector<BYTE>& cipher, const std::array<BYTE, 32>& key, const std::array<BYTE, 16>& iv, std::vector<BYTE>& plain)
{
    BCRYPT_ALG_HANDLE hAes = nullptr;
    BCRYPT_KEY_HANDLE hKey = nullptr;
    NTSTATUS status = BCryptOpenAlgorithmProvider(&hAes, BCRYPT_AES_ALGORITHM, nullptr, 0);
    if (status < 0) return false;

    status = BCryptSetProperty(hAes, BCRYPT_CHAINING_MODE, reinterpret_cast<PUCHAR>(const_cast<wchar_t*>(BCRYPT_CHAIN_MODE_CBC)), sizeof(BCRYPT_CHAIN_MODE_CBC), 0);
    if (status < 0)
    {
        BCryptCloseAlgorithmProvider(hAes, 0);
        return false;
    }

    DWORD objectLen = 0, resultLen = 0;
    status = BCryptGetProperty(hAes, BCRYPT_OBJECT_LENGTH, reinterpret_cast<PUCHAR>(&objectLen), sizeof(objectLen), &resultLen, 0);
    if (status < 0)
    {
        BCryptCloseAlgorithmProvider(hAes, 0);
        return false;
    }

    std::vector<BYTE> keyObj(objectLen);
    status = BCryptGenerateSymmetricKey(hAes, &hKey, keyObj.data(), objectLen, const_cast<PUCHAR>(key.data()), static_cast<ULONG>(key.size()), 0);
    if (status < 0)
    {
        BCryptCloseAlgorithmProvider(hAes, 0);
        return false;
    }

    std::array<BYTE, 16> ivCopy = iv;
    DWORD outLen = 0;
    status = BCryptDecrypt(hKey,
                           const_cast<PUCHAR>(cipher.data()), static_cast<ULONG>(cipher.size()),
                           nullptr,
                           ivCopy.data(), static_cast<ULONG>(ivCopy.size()),
                           nullptr, 0, &outLen,
                           BCRYPT_BLOCK_PADDING);

    if (status >= 0)
    {
        plain.resize(outLen);
        ivCopy = iv;
        status = BCryptDecrypt(hKey,
                               const_cast<PUCHAR>(cipher.data()), static_cast<ULONG>(cipher.size()),
                               nullptr,
                               ivCopy.data(), static_cast<ULONG>(ivCopy.size()),
                               plain.data(), outLen, &outLen,
                               BCRYPT_BLOCK_PADDING);
        if (status >= 0)
        {
            plain.resize(outLen);
        }
    }

    BCryptDestroyKey(hKey);
    BCryptCloseAlgorithmProvider(hAes, 0);
    return status >= 0;
}

#pragma pack(push, 1)
struct EncryptHeader
{
    char magic[8];
    BYTE salt[16];
    BYTE iv[16];
    UINT64 originalSize;
};
#pragma pack(pop)

static bool EncryptSelectedFile(HWND hWnd)
{
    if (g_selectedFilePath.empty())
    {
        MessageBoxW(hWnd, L"Select a file first.", L"EncryptDeat", MB_OK | MB_ICONINFORMATION);
        return false;
    }

    wchar_t password[256] = {};
    GetWindowTextW(g_hPasswordEdit, password, static_cast<int>(std::size(password)));
    if (password[0] == L'\0')
    {
        MessageBoxW(hWnd, L"Enter a password before encrypting.", L"EncryptDeat", MB_OK | MB_ICONWARNING);
        return false;
    }

    AppendOutput(L"Encrypt: reading input file...");

    std::vector<BYTE> plain;
    if (!ReadFileBytes(g_selectedFilePath, plain))
    {
        MessageBoxW(hWnd, L"Failed to read selected file.", L"EncryptDeat", MB_OK | MB_ICONERROR);
        return false;
    }

    std::array<BYTE, 16> salt{};
    std::array<BYTE, 16> iv{};
    BCryptGenRandom(nullptr, salt.data(), static_cast<ULONG>(salt.size()), BCRYPT_USE_SYSTEM_PREFERRED_RNG);
    BCryptGenRandom(nullptr, iv.data(), static_cast<ULONG>(iv.size()), BCRYPT_USE_SYSTEM_PREFERRED_RNG);

    std::array<BYTE, 32> key{};
    AppendOutput(L"Encrypt: deriving key (PBKDF2)...");
    if (!DeriveAes256Key(password, salt, key))
    {
        MessageBoxW(hWnd, L"Key derivation failed.", L"EncryptDeat", MB_OK | MB_ICONERROR);
        return false;
    }

    AppendOutput(L"Encrypt: AES-256 encryption in progress...");
    std::vector<BYTE> cipher;
    if (!AesCbcEncrypt(plain, key, iv, cipher))
    {
        MessageBoxW(hWnd, L"Encryption failed.", L"EncryptDeat", MB_OK | MB_ICONERROR);
        return false;
    }

    EncryptHeader header{};
    memcpy_s(header.magic, sizeof(header.magic), "EDEAT01", 7);
    memcpy_s(header.salt, sizeof(header.salt), salt.data(), salt.size());
    memcpy_s(header.iv, sizeof(header.iv), iv.data(), iv.size());
    header.originalSize = static_cast<UINT64>(plain.size());

    std::vector<BYTE> output(sizeof(EncryptHeader) + cipher.size());
    memcpy_s(output.data(), output.size(), &header, sizeof(header));
    memcpy_s(output.data() + sizeof(header), output.size() - sizeof(header), cipher.data(), cipher.size());

    std::wstring outPath = g_selectedFilePath + L".encd";
    AppendOutput(L"Encrypt: writing encrypted output...");
    if (!WriteFileBytes(outPath, output))
    {
        MessageBoxW(hWnd, L"Failed to write encrypted file.", L"EncryptDeat", MB_OK | MB_ICONERROR);
        return false;
    }

    AppendOutput(L"Encrypt complete: " + outPath);
    return true;
}

static bool DecryptSelectedFile(HWND hWnd)
{
    if (!(g_isElevatedAdmin && g_unsafeModeEnabled))
    {
        MessageBoxW(hWnd, L"Decrypt is restricted to elevated Unsafe Mode.", L"EncryptDeat", MB_OK | MB_ICONWARNING);
        return false;
    }

    if (g_selectedFilePath.empty())
    {
        MessageBoxW(hWnd, L"Select an encrypted file first.", L"EncryptDeat", MB_OK | MB_ICONINFORMATION);
        return false;
    }

    wchar_t password[256] = {};
    GetWindowTextW(g_hPasswordEdit, password, static_cast<int>(std::size(password)));
    if (password[0] == L'\0')
    {
        MessageBoxW(hWnd, L"Enter a password before decrypting.", L"EncryptDeat", MB_OK | MB_ICONWARNING);
        return false;
    }

    AppendOutput(L"Decrypt: reading encrypted file...");

    std::vector<BYTE> input;
    if (!ReadFileBytes(g_selectedFilePath, input) || input.size() < sizeof(EncryptHeader))
    {
        MessageBoxW(hWnd, L"Invalid encrypted file.", L"EncryptDeat", MB_OK | MB_ICONERROR);
        return false;
    }

    EncryptHeader header{};
    memcpy_s(&header, sizeof(header), input.data(), sizeof(header));
    if (strncmp(header.magic, "EDEAT01", 7) != 0)
    {
        MessageBoxW(hWnd, L"Selected file is not EncryptDeat format.", L"EncryptDeat", MB_OK | MB_ICONERROR);
        return false;
    }

    std::array<BYTE, 16> salt{};
    std::array<BYTE, 16> iv{};
    memcpy_s(salt.data(), salt.size(), header.salt, sizeof(header.salt));
    memcpy_s(iv.data(), iv.size(), header.iv, sizeof(header.iv));

    std::array<BYTE, 32> key{};
    AppendOutput(L"Decrypt: deriving key (PBKDF2)...");
    if (!DeriveAes256Key(password, salt, key))
    {
        MessageBoxW(hWnd, L"Key derivation failed.", L"EncryptDeat", MB_OK | MB_ICONERROR);
        return false;
    }

    std::vector<BYTE> cipher(input.begin() + static_cast<std::ptrdiff_t>(sizeof(EncryptHeader)), input.end());
    std::vector<BYTE> plain;

    AppendOutput(L"Decrypt: AES-256 decryption in progress...");
    if (!AesCbcDecrypt(cipher, key, iv, plain))
    {
        MessageBoxW(hWnd, L"Decryption failed. Password may be incorrect.", L"EncryptDeat", MB_OK | MB_ICONERROR);
        return false;
    }

    if (header.originalSize > plain.size())
    {
        MessageBoxW(hWnd, L"Decrypted content size mismatch.", L"EncryptDeat", MB_OK | MB_ICONERROR);
        return false;
    }

    plain.resize(static_cast<size_t>(header.originalSize));

    std::wstring outPath = g_selectedFilePath;
    size_t extPos = outPath.rfind(L".encd");
    if (extPos != std::wstring::npos && extPos == outPath.size() - 5)
    {
        outPath = outPath.substr(0, extPos);
    }
    outPath += L".decrypted";

    AppendOutput(L"Decrypt: writing output file...");
    if (!WriteFileBytes(outPath, plain))
    {
        MessageBoxW(hWnd, L"Failed to write decrypted file.", L"EncryptDeat", MB_OK | MB_ICONERROR);
        return false;
    }

    AppendOutput(L"Decrypt complete: " + outPath);
    return true;
}

static bool ComputeFileSha256(const std::wstring& path, int chunkMb, std::wstring& shaOut, ULONGLONG& sizeOut, FILETIME& writeTimeOut)
{
    HANDLE hFile = CreateFileW(path.c_str(), GENERIC_READ, FILE_SHARE_READ, nullptr, OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL, nullptr);
    if (hFile == INVALID_HANDLE_VALUE)
    {
        return false;
    }

    BY_HANDLE_FILE_INFORMATION fi{};
    if (!GetFileInformationByHandle(hFile, &fi))
    {
        CloseHandle(hFile);
        return false;
    }

    sizeOut = (static_cast<ULONGLONG>(fi.nFileSizeHigh) << 32ULL) | fi.nFileSizeLow;
    writeTimeOut = fi.ftLastWriteTime;

    BCRYPT_ALG_HANDLE hAlg = nullptr;
    BCRYPT_HASH_HANDLE hHash = nullptr;

    DWORD objLen = 0;
    DWORD hashLen = 0;
    DWORD cbResult = 0;

    NTSTATUS status = BCryptOpenAlgorithmProvider(&hAlg, BCRYPT_SHA256_ALGORITHM, nullptr, 0);
    if (status < 0)
    {
        CloseHandle(hFile);
        return false;
    }

    status = BCryptGetProperty(hAlg, BCRYPT_OBJECT_LENGTH, reinterpret_cast<PUCHAR>(&objLen), sizeof(objLen), &cbResult, 0);
    if (status < 0)
    {
        BCryptCloseAlgorithmProvider(hAlg, 0);
        CloseHandle(hFile);
        return false;
    }

    status = BCryptGetProperty(hAlg, BCRYPT_HASH_LENGTH, reinterpret_cast<PUCHAR>(&hashLen), sizeof(hashLen), &cbResult, 0);
    if (status < 0)
    {
        BCryptCloseAlgorithmProvider(hAlg, 0);
        CloseHandle(hFile);
        return false;
    }

    std::vector<BYTE> hashObj(objLen);
    status = BCryptCreateHash(hAlg, &hHash, hashObj.data(), objLen, nullptr, 0, 0);
    if (status < 0)
    {
        BCryptCloseAlgorithmProvider(hAlg, 0);
        CloseHandle(hFile);
        return false;
    }

    DWORD chunk = static_cast<DWORD>(chunkMb * 1024 * 1024);
    if (chunk < 4096) chunk = 4096;
    std::vector<BYTE> buf(chunk);

    DWORD read = 0;
    while (ReadFile(hFile, buf.data(), static_cast<DWORD>(buf.size()), &read, nullptr) && read > 0)
    {
        status = BCryptHashData(hHash, buf.data(), read, 0);
        if (status < 0)
        {
            BCryptDestroyHash(hHash);
            BCryptCloseAlgorithmProvider(hAlg, 0);
            CloseHandle(hFile);
            return false;
        }
    }

    std::vector<BYTE> hash(hashLen);
    status = BCryptFinishHash(hHash, hash.data(), hashLen, 0);

    BCryptDestroyHash(hHash);
    BCryptCloseAlgorithmProvider(hAlg, 0);
    CloseHandle(hFile);

    if (status < 0)
    {
        return false;
    }

    shaOut = BytesToHex(hash);
    return true;
}

static bool RunIntegrityCheck(HWND hWnd)
{
    if (g_selectedFilePath.empty())
    {
        MessageBoxW(hWnd, L"Select a file before running integrity check.", L"EncryptDeat", MB_OK | MB_ICONINFORMATION);
        return false;
    }

    ReadSettingsFromUi();

    AppendOutput(L"Integrity: hashing started...");

    std::wstring sha;
    ULONGLONG fileSize = 0;
    FILETIME lastWrite{};

    if (!ComputeFileSha256(g_selectedFilePath, g_settings.hashChunkMb, sha, fileSize, lastWrite))
    {
        MessageBoxW(hWnd, L"Integrity hash failed.", L"EncryptDeat", MB_OK | MB_ICONERROR);
        return false;
    }

    g_lastIntegrity.hasData = true;
    g_lastIntegrity.filePath = g_selectedFilePath;
    g_lastIntegrity.sha256 = sha;
    g_lastIntegrity.fileSize = fileSize;
    g_lastIntegrity.lastWriteTime = lastWrite;

    std::wostringstream line;
    line << L"Integrity complete | SHA256=" << sha << L" | Size=" << fileSize << L" bytes";
    if (g_settings.metadataChecks)
    {
        line << L" | LastWrite=" << FormatFileTimeLocal(lastWrite);
    }

    AppendOutput(line.str());
    return true;
}

