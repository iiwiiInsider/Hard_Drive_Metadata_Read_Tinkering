    json << L"  \"selectedFile\": \"" << JsonEscape(g_selectedFilePath) << L"\",\n";

    json << L"  \"integrity\": ";
    if (g_lastIntegrity.hasData)
    {
        json << L"{\"file\": \"" << JsonEscape(g_lastIntegrity.filePath)
             << L"\", \"sha256\": \"" << JsonEscape(g_lastIntegrity.sha256)
             << L"\", \"size\": " << g_lastIntegrity.fileSize
             << L", \"lastWrite\": \"" << JsonEscape(FormatFileTimeLocal(g_lastIntegrity.lastWriteTime)) << L"\"}";
    }
    else
    {
        json << L"null";
    }
    json << L"\n";

    json << L"}";
    return json.str();
}

static bool ExportReport(HWND hWnd)
{
    ReadSettingsFromUi();
    g_lastReportJson = BuildReportJson();

    wchar_t path[MAX_PATH] = L"EncryptDeat-Report.json";
    OPENFILENAMEW ofn{};
    ofn.lStructSize = sizeof(ofn);
    ofn.hwndOwner = hWnd;
    ofn.lpstrFilter = L"JSON Files (*.json)\0*.json\0Text Files (*.txt)\0*.txt\0All Files (*.*)\0*.*\0";
    ofn.lpstrFile = path;
    ofn.nMaxFile = MAX_PATH;
    ofn.Flags = OFN_OVERWRITEPROMPT | OFN_PATHMUSTEXIST;
    ofn.lpstrDefExt = L"json";

    if (!GetSaveFileNameW(&ofn))
    {
        return false;
    }

    std::ofstream out(path, std::ios::binary | std::ios::trunc);
    if (!out)
    {
        MessageBoxW(hWnd, L"Failed to open destination file.", L"EncryptDeat", MB_OK | MB_ICONERROR);
        return false;
    }

    std::string utf8 = WideToUtf8(g_lastReportJson);
    out.write(utf8.data(), static_cast<std::streamsize>(utf8.size()));

    if (!out.good())
    {
        MessageBoxW(hWnd, L"Failed to write report.", L"EncryptDeat", MB_OK | MB_ICONERROR);
        return false;
    }

    AppendOutput(L"Report exported: " + std::wstring(path));
    return true;
}

static bool SelectFileForWork(HWND hWnd)
{
    wchar_t path[MAX_PATH] = {};

    OPENFILENAMEW ofn{};
    ofn.lStructSize = sizeof(ofn);
    ofn.hwndOwner = hWnd;
    ofn.lpstrFilter = L"All Files (*.*)\0*.*\0";
    ofn.lpstrFile = path;
    ofn.nMaxFile = MAX_PATH;
    ofn.Flags = OFN_FILEMUSTEXIST | OFN_PATHMUSTEXIST;

    if (!GetOpenFileNameW(&ofn))
    {
        return false;
    }

    g_selectedFilePath = path;
    AppendOutput(L"Selected file: " + g_selectedFilePath);
    UpdateActionButtons();
    return true;
}

static void LayoutControls(HWND hWnd)
{
    RECT rc{};
    GetClientRect(hWnd, &rc);

    int margin = 12;
    int top = 150;
    int width = rc.right - rc.left;
    int height = rc.bottom - rc.top;

    int leftWidth = std::max(470, width / 2 - margin * 2);
    int rightX = margin + leftWidth + margin;
    int rightWidth = std::max(280, width - rightX - margin);

    int y = top;
    MoveWindow(g_hUnsafeCheck, margin, y, leftWidth - 120, 24, TRUE);
    MoveWindow(g_hUnsafeButton, margin + leftWidth - 110, y - 2, 100, 28, TRUE);
    y += 30;

    MoveWindow(g_hHashChunkEdit, margin, y, 70, 24, TRUE);
    MoveWindow(g_hMetadataCheck, margin + 80, y, 170, 24, TRUE);
    MoveWindow(g_hAggressiveCheck, margin + 260, y, 200, 24, TRUE);
    y += 30;

    MoveWindow(g_hRescanButton, margin, y, 120, 28, TRUE);
    MoveWindow(g_hSelectFileButton, margin + 130, y, 110, 28, TRUE);
    MoveWindow(g_hEncryptButton, margin + 250, y, 85, 28, TRUE);
    MoveWindow(g_hDecryptButton, margin + 345, y, 85, 28, TRUE);
    y += 34;

    MoveWindow(g_hIntegrityButton, margin, y, 170, 28, TRUE);
    MoveWindow(g_hExportButton, margin + 180, y, 160, 28, TRUE);
    MoveWindow(g_hPasswordEdit, margin + 350, y + 2, leftWidth - 350, 24, TRUE);
    y += 34;

    int driveListHeight = std::max(140, height - y - margin);
    MoveWindow(g_hDriveList, margin, y, leftWidth, driveListHeight, TRUE);

    MoveWindow(g_hOutputEdit, rightX, top, rightWidth, std::max(220, height - top - margin), TRUE);
}

static void DrawFuturisticHeader(HDC hdc, const RECT& rc, const std::wstring& text)
{
    SetBkMode(hdc, TRANSPARENT);
    SetTextColor(hdc, RGB(100, 220, 255));

    HFONT hFont = CreateFontW(-20, 0, 0, 0, FW_BOLD, FALSE, FALSE, FALSE,
                              DEFAULT_CHARSET, OUT_DEFAULT_PRECIS, CLIP_DEFAULT_PRECIS,
                              CLEARTYPE_QUALITY, VARIABLE_PITCH, L"Segoe UI");

    HFONT old = static_cast<HFONT>(SelectObject(hdc, hFont));
    RECT copy = rc;
    DrawTextW(hdc, text.c_str(), -1, &copy, DT_LEFT | DT_VCENTER | DT_SINGLELINE);
    SelectObject(hdc, old);
    DeleteObject(hFont);
}

static void DoPaint(HWND hWnd, HDC hdc)
{
    RECT rc{};
    GetClientRect(hWnd, &rc);

    HBRUSH bg = CreateSolidBrush(RGB(2, 10, 22));
    FillRect(hdc, &rc, bg);
    DeleteObject(bg);

    HPEN grid = CreatePen(PS_SOLID, 1, RGB(10, 70, 120));
    HPEN glow = CreatePen(PS_SOLID, 1, RGB(20, 130, 200));

    SelectObject(hdc, grid);
    for (int y = 0; y < rc.bottom; y += 26)
    {
        MoveToEx(hdc, 0, y, nullptr);
        LineTo(hdc, rc.right, y);
    }

    SelectObject(hdc, glow);
    for (int x = 0; x < rc.right; x += 36)
    {
        MoveToEx(hdc, x, 0, nullptr);
        LineTo(hdc, x, rc.bottom);
    }

    DeleteObject(grid);
    DeleteObject(glow);

    RECT header = { 12, 12, rc.right - 12, 44 };
    std::wstring mode = g_unsafeModeEnabled ? L"EncryptDeat // UNSAFE MODE" : L"EncryptDeat // SAFE MODE";
    DrawFuturisticHeader(hdc, header, mode);

    RECT status = { 12, 50, rc.right - 12, 130 };
    std::wstring text;
    if (!g_isElevatedAdmin)
    {
        text = L"Not elevated. Unsafe mode is forced OFF. Decrypt/aggressive options are locked.";
    }
    else
    {
        text = g_unsafeModeEnabled
                   ? L"Elevated admin detected. Unsafe mode enabled for gated operations."
                   : L"Elevated admin detected. Unsafe mode is OFF by default.";
    }

    HFONT body = CreateFontW(-14, 0, 0, 0, FW_NORMAL, FALSE, FALSE, FALSE,
                             DEFAULT_CHARSET, OUT_DEFAULT_PRECIS, CLIP_DEFAULT_PRECIS,
                             CLEARTYPE_QUALITY, VARIABLE_PITCH, L"Consolas");
    HFONT old = static_cast<HFONT>(SelectObject(hdc, body));
    SetTextColor(hdc, RGB(170, 225, 255));
    DrawTextW(hdc, text.c_str(), -1, &status, DT_LEFT | DT_TOP | DT_WORDBREAK);
    SelectObject(hdc, old);
    DeleteObject(body);
}

